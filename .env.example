# Master on/off switch for self-healing. Unset or anything other than false/0 leaves it on.
HEALER_ENABLED=true

# Which provider backs the self-healing LLM call: ollama | openai | anthropic | gemini
HEALER_PROVIDER=ollama

# --- Ollama Cloud (https://ollama.com) ---
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com

# --- OpenAI ---
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (uses the official @anthropic-ai/sdk) ---
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Google Gemini ---
# GEMINI_MODEL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Base URL of the application under test (see playwright.config.ts)
# APP_BASE_URL=https://vibetestq-osondemand.orangehrm.com/
